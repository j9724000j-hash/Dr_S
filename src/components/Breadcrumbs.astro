---
/** فتات التنقل + بيانات منظمة BreadcrumbList (spec §18/§24) */
import type { Locale } from '../i18n/ui';
import { useTranslations, useTranslatedPath } from '../i18n/utils';

interface Crumb { label: string; href?: string; }
interface Props { lang: Locale; items: Crumb[]; }

const { lang, items } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);
const base = Astro.site?.toString().replace(/\/$/, '') ?? '';

const crumbs: Crumb[] = [{ label: t('breadcrumb.home'), href: tp('/') }, ...items];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: `${base}${c.href}` } : {}),
  })),
};
---

<nav class="breadcrumbs container" aria-label={t('breadcrumb.aria')}>
  <ol>
    {crumbs.map((c, i) => (
      <li>
        {i > 0 && <span class="crumb-sep" aria-hidden="true">›</span>}
        {c.href && i < crumbs.length - 1 ? (
          <a href={c.href}>{c.label}</a>
        ) : (
          <span aria-current="page">{c.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
