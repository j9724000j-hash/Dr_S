---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import type { Locale } from '../i18n/ui';
import { useTranslations, useTranslatedPath, stripLocalePrefix, localizePath } from '../i18n/utils';
import { clinic } from '../data/clinic';

interface Props { lang: Locale; }
const { lang } = Astro.props;

const t = useTranslations(lang);
const tp = useTranslatedPath(lang);
const isAr = lang === 'ar';
const stripped = stripLocalePrefix(Astro.url.pathname);

/* تنقل بسيط وراقٍ (spec §44) — لا نثقل الرأس */
const navItems = [
  { href: tp('/'), label: t('nav.home') },
  { href: tp('/about'), label: t('nav.about') },
  { href: tp('/services'), label: t('nav.services') },
  { href: tp('/faq'), label: t('nav.faq') },
  { href: tp('/journal'), label: t('nav.journal') },
];

const otherLang: Locale = lang === 'ar' ? 'en' : 'ar';
// مبدّل اللغة: نفس المسار الحالي باللغة الأخرى مع بادئة النشر (base).
// صفحة 404 العربية تُبنى كملف dist/404.html (بلا مسار مجلد) → نعود للرئيسية.
const isNotFound = /\/404\/?$/.test(Astro.url.pathname);
const otherUrl = localizePath(otherLang, isNotFound ? '/' : stripped);
// تمييز الرابط النشط: مقارنة المسار الحالي (مع base وبادئة اللغة) بروابط التنقل
const norm = (p: string) => (p.length > 1 ? p.replace(/\/+$/, '') : p);
const homeHref = norm(tp('/'));
const isActive = (href: string) => {
  const h = norm(href);
  const current = norm(Astro.url.pathname);
  if (h === homeHref) return current === h;
  return current === h || current.startsWith(`${h}/`);
};
---

<header class="site-header">
  <div class="container header-inner">
    <a href={tp('/')} class="brand" aria-label={t('nav.home')}>
      <Logo size={46} />
      <span class="brand-text">
        <span class="brand-name-en">Dr. Sumaia Alhalabi</span>
        <span class="brand-name-ar">{isAr ? clinic.nameAr : clinic.nameEn}</span>
        <span class="brand-sub">{t('brand.sub')}</span>
      </span>
    </a>

    <nav class="main-nav" aria-label={t('nav.label')}>
      {navItems.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a
        class="lang-switch"
        href={otherUrl}
        hreflang={otherLang}
        lang={otherLang}
        aria-label={`${t('lang.aria')} — ${otherLang === 'ar' ? 'عربي' : 'English'}`}
        data-lang-choice={otherLang}
      >
        {otherLang === 'ar' ? 'عربي' : 'EN'}
      </a>
      <a class="btn btn-primary btn-sm header-call" href={clinic.phoneHref}>
        <Icon name="phone" size={16} />
        {t('cta.call')}
      </a>
      <details class="mobile-nav">
        <summary aria-label={t('nav.label')}><Icon name="menu" size={22} /></summary>
        <nav aria-label={t('nav.label')}>
          {navItems.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
          <a href={tp('/contact')} aria-current={stripped === '/contact' || stripped === '/contact/' ? 'page' : undefined}>
            {t('nav.contact')}
          </a>
          <a href={clinic.phoneHref} class="mobile-call">
            <Icon name="phone" size={17} /> <b>{t('cta.call')}</b>
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>

{
  /* حفظ تفضيل اللغة عند اختيارها الصريح (spec §0.16.11) —
     التخزين محلي أولي وخفيف، ولا يتجاوز أبداً عنواناً محلياً صريحاً. */
}
<script is:inline>
  document.querySelectorAll('a[data-lang-choice]').forEach(function (a) {
    a.addEventListener('click', function () {
      try {
        localStorage.setItem('lang-pref', a.getAttribute('data-lang-choice'));
      } catch (e) {}
    });
  });
</script>
