---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import type { Locale } from '../i18n/ui';
import { useTranslations, useTranslatedPath } from '../i18n/utils';
import { clinic } from '../data/clinic';

interface Props { lang: Locale; }
const { lang } = Astro.props;

const t = useTranslations(lang);
const tp = useTranslatedPath(lang);
const isAr = lang === 'ar';
const year = new Date().getFullYear();

const quickLinks = [
  { href: tp('/'), label: t('nav.home') },
  { href: tp('/about'), label: t('nav.about') },
  { href: tp('/services'), label: t('nav.services') },
  { href: tp('/faq'), label: t('nav.faq') },
  { href: tp('/journal'), label: t('nav.journal') },
  { href: tp('/contact'), label: t('nav.contact') },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a href={tp('/')} class="brand">
        <Logo size={42} variant="light" />
        <span class="brand-text">
          <span class="brand-name-en">Dr. Sumaya Alhalabi</span>
          <span class="brand-name-ar">د. سمية الحلبي</span>
          <span class="brand-sub">{t('brand.sub')}</span>
        </span>
      </a>
      <p class="about-p">{t('footer.about')}</p>
      <div class="socials">
        <a href={clinic.facebookUrl} target="_blank" rel="noopener" aria-label="Facebook">
          <Icon name="facebook" size={20} />
        </a>
        <a href={clinic.whatsappUrl} target="_blank" rel="noopener" aria-label="WhatsApp">
          <Icon name="whatsapp" size={20} />
        </a>
        <a href={clinic.phoneHref} aria-label={t('cta.call.aria')}>
          <Icon name="phone" size={20} />
        </a>
      </div>
    </div>

    <div>
      <h4>{t('footer.links')}</h4>
      <ul>
        {quickLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h4>{t('footer.contact')}</h4>
      <ul class="footer-contact">
        <li><Icon name="phone" size={18} /><a href={clinic.phoneHref} dir="ltr">{clinic.phone} · {clinic.phoneIntl}</a></li>
        <li><Icon name="pin" size={18} /><span>{isAr ? clinic.locationAr : clinic.locationEn}</span></li>
        <li><Icon name="facebook" size={18} /><a href={clinic.facebookUrl} target="_blank" rel="noopener" dir="ltr">{clinic.facebook}</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p class="footer-disclaimer">{t('footer.disclaimer')}</p>
      <p>© {year} {isAr ? clinic.nameAr : clinic.nameEn} · {t('footer.rights')}</p>
    </div>
  </div>
</footer>
