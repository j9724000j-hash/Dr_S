---
/**
 * صفحة التواصل — الهاتف أولاً (spec §12/§14):
 * بدون نماذج اتصال أو حجز. الهاتف + واتساب كقناة ثانوية مؤكدة +
 * العنوان المؤكد + فيسبوك. أوقات العمل غير مؤكدة → لا تُعرض كحقائق.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import SectionHeading from '../SectionHeading.astro';
import Icon from '../Icon.astro';
import type { Locale } from '../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';
import { getMeta } from '../../data/meta';
import { clinic } from '../../data/clinic';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);
const isAr = lang === 'ar';
const meta = getMeta('/contact', lang);

const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  name: isAr ? clinic.nameAr : clinic.nameEn,
  telephone: clinic.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: isAr ? 'أوتوستراد المزة' : 'Mezzeh Autostrad',
    addressLocality: isAr ? 'دمشق' : 'Damascus',
    addressCountry: 'SY',
  },
  sameAs: [clinic.facebookUrl],
}];
---

<BaseLayout lang={lang} title={meta.title} description={meta.description} jsonLd={jsonLd}>
  <Breadcrumbs lang={lang} items={[{ label: t('nav.contact') }]} />

  <section class="section">
    <div class="container">
      <SectionHeading h1 eyebrow={t('contact.eyebrow')} title={t('contact.title')} sub={t('contact.sub')} />

      <!-- بطاقة الاتصال الرئيسية — التحويل الأساسي في الموقع (spec §0.7) -->
      <div class="call-hero">
        <span class="call-hero-icon"><Icon name="phone" size={30} /></span>
        <div>
          <h2>{t('contact.call.title')}</h2>
          <p>{t('contact.call.desc')}</p>
        </div>
        <a class="btn btn-primary btn-lg" href={clinic.phoneHref} dir="ltr">{clinic.phone}</a>
        <span class="call-hero-intl" dir="ltr">{clinic.phoneIntl}</span>
      </div>

      <div class="contact-page-grid contact-no-form">
        <div class="info-list">
          <a class="info-item" href={clinic.whatsappUrl} target="_blank" rel="noopener">
            <span class="icon-circle"><Icon name="whatsapp" size={20} /></span>
            <span><b>{t('contact.whatsapp')}</b><span>{t('contact.whatsapp.desc')}</span></span>
          </a>
          <a class="info-item" href={clinic.mapsUrl} target="_blank" rel="noopener">
            <span class="icon-circle"><Icon name="pin" size={20} /></span>
            <span><b>{t('contact.location')}</b><span>{isAr ? clinic.locationAr : clinic.locationEn}</span></span>
          </a>
          <a class="info-item" href={clinic.facebookUrl} target="_blank" rel="noopener">
            <span class="icon-circle"><Icon name="facebook" size={20} /></span>
            <span><b>{t('contact.facebook')}</b><span dir="ltr">{clinic.facebook}</span></span>
          </a>
          <div class="info-item">
            <span class="icon-circle"><Icon name="clock" size={20} /></span>
            <span><b>{isAr ? 'أوقات العمل' : 'Working Hours'}</b><span>{t('contact.hours.pending')}</span></span>
          </div>
        </div>

        <!-- خريطة: رابط مباشر (بانتظار تفعيل التضمين مع تأكيد الموقع الدقيق) -->
        <a class="map-card" href={clinic.mapsUrl} target="_blank" rel="noopener">
          <span class="map-pin"><Icon name="pin" size={26} /></span>
          <b>{isAr ? clinic.locationAr : clinic.locationEn}</b>
          <span class="map-link">{t('contact.maps')} <Icon name="arrow" size={15} /></span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
