---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import SectionHeading from '../SectionHeading.astro';
import Icon from '../Icon.astro';
import type { Locale } from '../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';
import { getMeta } from '../../data/meta';
import { clinic } from '../../data/clinic';
import { img, imgSize } from '../../data/images';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);
const isAr = lang === 'ar';
const meta = getMeta('/about', lang);

const approach = [
  t('about.approach1'),
  t('about.approach2'),
  t('about.approach3'),
  t('about.approach4'),
];

/* Person — معلومات مؤكدة فقط: الاسم والتخصص والعنوان (بدون مؤلفات أو شهادات — spec §5) */
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: isAr ? clinic.nameAr : clinic.nameEn,
  jobTitle: isAr ? clinic.specialtyAr : clinic.specialtyEn,
  address: {
    '@type': 'PostalAddress',
    streetAddress: isAr ? 'أوتوستراد المزة' : 'Mezzeh Autostrad',
    addressLocality: isAr ? 'دمشق' : 'Damascus',
    addressCountry: 'SY',
  },
}];
---

<BaseLayout lang={lang} title={meta.title} description={meta.description} jsonLd={jsonLd}>
  <Breadcrumbs lang={lang} items={[{ label: t('nav.about') }]} />

  <section class="section">
    <div class="container about-grid">
      <!-- إطار صورة الدكتورة — بديل بصري أنيق حتى تتوفر صورة حقيقية
           (استبدال الأصل لاحقاً لا يتطلب أي تغيير في التصميم — spec §6/§36) -->
      <div class="about-photo">
        <div class="photo-frame portrait-placeholder">
          <img src={img.toothOutline} alt="" width={1264} height={843} loading="lazy" aria-hidden="true" />
          <span class="portrait-monogram" aria-hidden="true">S</span>
          <span class="portrait-name">{isAr ? clinic.nameAr : clinic.nameEn}</span>
        </div>
      </div>

      <div class="about-copy">
        <SectionHeading h1 eyebrow={t('about.eyebrow')} title={t('about.title')} />
        <p class="role">{t('about.role')}</p>
        <p>{t('about.p1')}</p>
        <p>{t('about.p2')}</p>

        <h2 class="approach-title">{t('about.approachTitle')}</h2>
        <ul class="approach-list">
          {approach.map((item) => (
            <li><Icon name="check" size={15} /> {item}</li>
          ))}
        </ul>

        <div class="about-cta-row">
          <a class="btn btn-primary" href={clinic.phoneHref}>
            <Icon name="phone" size={17} /> {t('about.cta')}
          </a>
          <a class="btn btn-ghost" href={tp('/services')}>{t('cta.services')}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- فلسفة العناية -->
  <section class="section alt">
    <div class="container philosophy-grid">
      <div class="philosophy-visual">
        <img
          src={img.comfort}
          alt={isAr ? 'أجواء راحة وهدوء — مفهوم بصري بهوية العيادة' : 'A calm, comfortable atmosphere — conceptual brand visual'}
          width={imgSize[img.comfort][0]}
          height={imgSize[img.comfort][1]}
          loading="lazy"
        />
      </div>
      <div>
        <h2>{t('about.philosophyTitle')}</h2>
        <blockquote class="doctor-quote">{t('home.doctor.philosophy')}</blockquote>
        <div class="signature">
          <span class="script-sign">Sumaya</span>
          <span class="sig-ar">{isAr ? clinic.nameAr : clinic.nameEn}</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
