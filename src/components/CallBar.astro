---
/**
 * شريط الاتصال السفلي للموبايل (spec §31):
 * إجراء اتصال راقٍ ومدمج بالهوية، لا يعيق المحتوى،
 * وليس ويدجت عائماً رخيص الشكل.
 */
import Icon from './Icon.astro';
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { clinic } from '../data/clinic';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="call-bar" role="complementary" aria-label={t('cta.call.aria')}>
  <div class="call-bar-inner container">
    <a class="call-bar-btn" href={clinic.phoneHref}>
      <Icon name="phone" size={19} />
      <span>{t('callbar.label')}</span>
      <bdi dir="ltr">{clinic.phone}</bdi>
    </a>
    <a
      class="call-bar-wa"
      href={clinic.whatsappUrl}
      target="_blank"
      rel="noopener"
      aria-label={t('cta.whatsapp')}
    >
      <Icon name="whatsapp" size={21} />
    </a>
  </div>
</div>
