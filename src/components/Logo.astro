---
/**
 * شعار العيادة — نسخة SVG مُعاد إنشاؤها من الهوية البصرية
 * (TODO: استبدالها بالملف الرسمي للشعار عند توفره)
 */
interface Props {
  size?: number;
  variant?: 'dark' | 'light';
  class?: string;
}

const { size = 44, variant = 'dark', class: className } = Astro.props;

const stroke = variant === 'light' ? '#FFFFFF' : '#5B3B82';
const fill = variant === 'light' ? 'rgba(255,255,255,0.14)' : '#EDE7F6';
const letter = variant === 'light' ? '#FFFFFF' : '#5B3B82';
const petal = variant === 'light' ? '#C9BBE8' : '#A98FCB';
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 96 96"
  fill="none"
  aria-hidden="true"
>
  <path
    d="M48 16C33 16 24 26 25 41c1 13 7 31 13.5 31C44 72 43.5 57 48 57s4 15 9.5 15C64 72 70 54 71 41 72 26 63 16 48 16Z"
    fill={fill}
    stroke={stroke}
    stroke-width="4.5"
    stroke-linejoin="round"
  />
  <text
    x="48"
    y="48"
    text-anchor="middle"
    dominant-baseline="central"
    font-family="'Great Vibes', cursive"
    font-size="30"
    fill={letter}>S</text
  >
  <g>
    <ellipse cx="30" cy="17.5" rx="3.4" ry="6.5" fill={petal} />
    <ellipse cx="30" cy="17.5" rx="3.4" ry="6.5" fill={petal} transform="rotate(72 30 24)" />
    <ellipse cx="30" cy="17.5" rx="3.4" ry="6.5" fill={petal} transform="rotate(144 30 24)" />
    <ellipse cx="30" cy="17.5" rx="3.4" ry="6.5" fill={petal} transform="rotate(216 30 24)" />
    <ellipse cx="30" cy="17.5" rx="3.4" ry="6.5" fill={petal} transform="rotate(288 30 24)" />
    <circle cx="30" cy="24" r="3" fill={stroke} />
  </g>
</svg>
