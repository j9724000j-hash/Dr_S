---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CallBar from '../components/CallBar.astro';
import type { Locale } from '../i18n/ui';
import { stripLocalePrefix, withBase } from '../i18n/utils';
import { clinic } from '../data/clinic';
import { toJsonLd } from '../utils/jsonld';

import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '@fontsource/tajawal/400.css';
import '@fontsource/tajawal/500.css';
import '@fontsource/tajawal/700.css';
import '@fontsource/tajawal/800.css';
import '@fontsource/great-vibes/400.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang: Locale;
  /** نوع الصفحة لأغراض og:type */
  ogType?: 'website' | 'article';
  /** بيانات منظمة JSON-LD إضافية خاصة بالصفحة (معلومات مؤكدة فقط — spec §0.8) */
  jsonLd?: object[];
}

const {
  title,
  description = 'عيادة الدكتورة سميّا الحلبي — طب الأسنان العلاجي و التجميلي في دمشق.',
  lang,
  ogType = 'website',
  jsonLd = [],
} = Astro.props;

const dir = lang === 'ar' ? 'rtl' : 'ltr';
// أصل الموقع + مسار النشر مركزيان في astro.config.mjs (site + base):
//   https://j9724000j-hash.github.io  +  /Dr_S/
// canonical/hreflang/og:image تُبنى من الأصل + withBase(المسار) دائماً.
const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = `${siteOrigin}${Astro.url.pathname}`;
const arPath = stripLocalePrefix(Astro.url.pathname);
const enPath = arPath === '/' ? '/en/' : `/en${arPath}`;
const arUrl = `${siteOrigin}${withBase(arPath)}`;
const enUrl = `${siteOrigin}${withBase(enPath)}`;
const siteName = `${clinic.nameEn} | ${clinic.specialtyEn}`;
const ogImage = `${siteOrigin}${withBase('/images/og-home.jpg')}`;
const isRootAr = lang === 'ar' && arPath === '/';
// صفحة 404 ليست عنواناً قابلاً للفهرسة: لا canonical/hreflang لها + noindex
const isErrorPage = /\/404\/?$/.test(Astro.url.pathname);
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      isErrorPage ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang="ar" href={arUrl} />
          <link rel="alternate" hreflang="en" href={enUrl} />
          <link rel="alternate" hreflang="x-default" href={arUrl} />
        </>
      )
    }
    <meta name="theme-color" content="#5B3B82" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_AR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd.map((data) => (
      <script type="application/ld+json" set:html={toJsonLd(data)} />
    ))}
    {
      /* اختيار اللغة الأولي (spec §0.16.2/§0.16.3/§0.16.14):
         يعمل على الجذر "/" فقط، خفيف، لا يمنع الزحف أبداً (لا إعادة توجيه
         قسرية لأي مسار محلي)، ويحترم التفضيل المحفوظ ثم لغة المتصفح،
         والافتراضي العربية. المحتوى نفسه موجود بالكامل بدون جافاسكربت. */
      isRootAr && (
        <script is:inline data-en-url={withBase('/en')}>
          (function () {
            try {
              var pref = localStorage.getItem('lang-pref');
              if (pref === 'ar' || pref === 'en') return; // تفضيل محفوظ → يبقى الزائر حيث هو
              var langs = navigator.languages || [navigator.language || ''];
              var wantsAr = langs.some(function (l) {
                return (l || '').toLowerCase().indexOf('ar') === 0;
              });
              var wantsEn = langs.some(function (l) {
                return (l || '').toLowerCase().indexOf('en') === 0;
              });
              /* الرابط الهدف يمرّ عبر withBase() وقت البناء (base مستودع الصفحات) */
              var target = document.currentScript && document.currentScript.getAttribute('data-en-url');
              if (!wantsAr && wantsEn) location.replace(target || '/en');
            } catch (e) {
              /* تجاهل: الجذر يبقى عربياً */
            }
          })();
        </script>
      )
    }
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <CallBar lang={lang} />
  </body>
</html>
